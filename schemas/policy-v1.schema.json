{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustfall.dev/schemas/policy-v1.schema.json",
  "title": "TrustFall policy v1",
  "type": "object",
  "required": ["version", "mode"],
  "properties": {
    "version": { "const": "1" },
    "mode": { "enum": ["audit", "enforce"] },
    "fail_on": { "enum": ["note", "low", "medium", "high", "critical"] },
    "deny_rules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "expectations": { "type": "object", "additionalProperties": { "type": "object", "required": ["status", "condition"], "properties": { "status": { "enum": ["pass", "fail", "informational", "unknown", "not_applicable"] }, "condition": { "type": "string" } }, "additionalProperties": false } },
    "identity": { "type": "object", "properties": { "request_oidc": { "type": "boolean" }, "audience": { "type": "string", "maxLength": 255 } }, "additionalProperties": false },
    "network": {
      "type": "object",
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/networkTarget" } },
        "metadata": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "providers": { "type": "array", "items": { "enum": ["aws", "azure", "gcp"] }, "uniqueItems": true }
          },
          "allOf": [{ "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["providers"], "properties": { "providers": { "minItems": 1 } } } }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cloud": {
      "type": "object",
      "properties": {
        "aws": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "audience": { "const": "sts.amazonaws.com" },
            "role_arn": { "type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]{1,512}$" },
            "session_name": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[A-Za-z0-9+=,.@_-]+$" },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/awsTarget" } }
          },
          "allOf": [{ "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["role_arn", "targets"], "properties": { "targets": { "minItems": 1 } } } }],
          "additionalProperties": false
        },
        "azure": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "audience": { "type": "string" },
            "scope": { "const": "https://management.azure.com/.default" },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/azureTarget" } }
          },
          "allOf": [{ "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["targets"], "properties": { "targets": { "minItems": 1 } } } }],
          "additionalProperties": false
        },
        "gcp": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "workload_identity_provider": { "type": "string", "pattern": "^projects/[0-9]+/locations/global/workloadIdentityPools/[A-Za-z0-9_-]+/providers/[A-Za-z0-9_-]+$" },
            "audience": { "type": "string", "pattern": "^https://iam\\.googleapis\\.com/projects/[0-9]+/locations/global/workloadIdentityPools/[A-Za-z0-9_-]+/providers/[A-Za-z0-9_-]+$" },
            "scope": { "const": "https://www.googleapis.com/auth/cloud-platform" },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/gcpTarget" } }
          },
          "allOf": [{ "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["workload_identity_provider", "targets"], "properties": { "targets": { "minItems": 1 } } } }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "networkTarget": {
      "type": "object",
      "required": ["name", "type", "address"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["dns", "tcp", "https"] },
        "address": { "type": "string", "minLength": 1 },
        "expect_reachable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "azureTarget": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://management\\.azure\\.com/" },
        "method": { "enum": ["GET", "HEAD", "get", "head", ""] },
        "expected_status": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "awsTarget": {
      "type": "object",
      "required": ["name", "url", "service", "region"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "service": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "region": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "method": { "enum": ["GET", "HEAD", "get", "head", ""] },
        "expected_status": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "gcpTarget": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://[^/]+\\.googleapis\\.com(?:/|$)" },
        "method": { "enum": ["GET", "HEAD", "get", "head", ""] },
        "expected_status": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
